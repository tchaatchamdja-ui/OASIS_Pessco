        <di:waypoint x="852" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_7_di" bpmnElement="Flow_S2_7">
        <di:waypoint x="735" y="120" />
        <di:waypoint x="815" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_8_di" bpmnElement="Flow_S2_8">
        <di:waypoint x="925" y="120" />
        <di:waypoint x="945" y="120" />
        <di:waypoint x="945" y="480" />
        <di:waypoint x="975" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_9_di" bpmnElement="Flow_S2_9">
        <di:waypoint x="1085" y="480" />
