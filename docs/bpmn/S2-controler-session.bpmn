        <di:waypoint x="1215" y="120" />
        <di:waypoint x="1325" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_12_di" bpmnElement="Flow_S2_12">
