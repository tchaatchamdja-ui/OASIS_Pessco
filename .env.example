# OASIS — variables d'environnement (ARCH-02)
# Copier en .env et adapter, ou exporter ces variables au lancement.
# La configuration métier (politique de mots de passe, modules, instance)
# reste dans config/aerosup.config.json.

# Port d'écoute du serveur.
PORT=4750

# production active : cookie Secure, HSTS, cache des fichiers statiques.
NODE_ENV=development

# Répertoires surchargeables (instances multiples, tests).
# OASIS_DATA_DIR=/var/lib/oasis/data
# OASIS_CONFIG_DIR=/etc/oasis

# Derrière un proxy inverse (nginx, Caddy, Traefik) : req.ip devient
# l'adresse réelle du client, indispensable à la limitation de débit.
# OASIS_TRUST_PROXY=1

# Le proxy compresse déjà les réponses ? Couper la compression applicative.
# OASIS_COMPRESSION=0

# Mot de passe des comptes créés au premier démarrage. Absent, il est tiré au
# hasard et affiché une seule fois sur la console.
# OASIS_SEED_PASSWORD=UnMotDePasse!2026

# Jeu de données des tests de fumée (défaut : tests/fixtures).
# OASIS_SMOKE_DATA=tests/fixtures
