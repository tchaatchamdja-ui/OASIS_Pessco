      <bpmndi:BPMNShape id="s2_gw_connue_di" bpmnElement="s2_gw_connue" isMarkerVisible="true"><dc:Bounds x="525" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_fin_inconnue_di" bpmnElement="s2_fin_inconnue"><dc:Bounds x="532" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_gw_inactif_di" bpmnElement="s2_gw_inactif" isMarkerVisible="true"><dc:Bounds x="685" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_retirer_di" bpmnElement="s2_retirer"><dc:Bounds x="655" y="440" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_fin_expiree_di" bpmnElement="s2_fin_expiree"><dc:Bounds x="852" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_activite_di" bpmnElement="s2_activite"><dc:Bounds x="815" y="80" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_instantane_di" bpmnElement="s2_instantane"><dc:Bounds x="975" y="440" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_gw_compte_di" bpmnElement="s2_gw_compte" isMarkerVisible="true"><dc:Bounds x="1165" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_fin_compte_di" bpmnElement="s2_fin_compte"><dc:Bounds x="1172" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_gw_ecriture_di" bpmnElement="s2_gw_ecriture" isMarkerVisible="true"><dc:Bounds x="1325" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_compter_di" bpmnElement="s2_compter"><dc:Bounds x="1455" y="200" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_gw_plafond_di" bpmnElement="s2_gw_plafond" isMarkerVisible="true"><dc:Bounds x="1645" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_debit_di" bpmnElement="s2_debit"><dc:Bounds x="1615" y="320" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_fin_429_di" bpmnElement="s2_fin_429"><dc:Bounds x="1812" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_fusion_di" bpmnElement="s2_fusion" isMarkerVisible="true"><dc:Bounds x="1805" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_fin_ok_di" bpmnElement="s2_fin_ok"><dc:Bounds x="1972" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_S2_1_di" bpmnElement="Flow_S2_1">
        <di:waypoint x="248" y="120" />
        <di:waypoint x="335" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_2_di" bpmnElement="Flow_S2_2">
        <di:waypoint x="445" y="120" />
        <di:waypoint x="525" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_3_di" bpmnElement="Flow_S2_3">
        <di:waypoint x="550" y="145" />
        <di:waypoint x="550" y="222" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_4_di" bpmnElement="Flow_S2_4">
        <di:waypoint x="575" y="120" />
        <di:waypoint x="685" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_5_di" bpmnElement="Flow_S2_5">
        <di:waypoint x="710" y="145" />
        <di:waypoint x="710" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_6_di" bpmnElement="Flow_S2_6">
        <di:waypoint x="765" y="480" />
