# Dépendances
node_modules/

# Données d'exploitation : comptes, hachages, journal d'audit, dossiers.
# Un jeu de référence versionné est fourni dans tests/fixtures/.
data/
# Le magasin du serveur de développement : une copie de data/, qu'il sert à
# la place du vrai. Sans lui, « npm run dev » écrit le journal d'audit chaîné
# de l'instance — et le garde-fou de la campagne refuse alors de rendre 0.
data-dev/
sauvegardes/

# Variables d'environnement (le modèle .env.example est versionné)
.env
.env.local

# Sorties de travail
audit-output/
*.tmp
*.log

# Système
.DS_Store

# Documents de travail à la racine (sources métier, non nécessaires au code)
/*.xlsx
/*.docx
public/modules/*/app/
# Le socle commun en cours de conversion (ADR-003, 5.b) : `shared/js/` est ce qui
# est encore écrit en JavaScript, `shared/app/` ce qui est construit à partir de
# `frontend/socle/`. Le jour où `shared/js/` est vide, les deux disparaissent.
public/shared/app/
# Le portail en cours de conversion (ADR-003, 5.c) : `public/js/` est ce qui est
# encore écrit en JavaScript, `public/app/` ce qui est construit à partir de
# `frontend/portail/`. Même règle que le socle, même jour de disparition.
public/app/
