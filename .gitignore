# Dépendances
node_modules/

# Données d'exploitation : comptes, hachages, journal d'audit, dossiers.
# Un jeu de référence versionné est fourni dans tests/fixtures/.
data/
sauvegardes/

# Variables d'environnement (le modèle .env.example est versionné)
.env
.env.local

# Sorties de travail
audit-output/
*.tmp
*.log

# Système
.DS_Store

# Documents de travail à la racine (sources métier, non nécessaires au code)
/*.xlsx
/*.docx
public/modules/*/app/
# Le socle commun en cours de conversion (ADR-003, 5.b) : `shared/js/` est ce qui
# est encore écrit en JavaScript, `shared/app/` ce qui est construit à partir de
# `frontend/socle/`. Le jour où `shared/js/` est vide, les deux disparaissent.
public/shared/app/
