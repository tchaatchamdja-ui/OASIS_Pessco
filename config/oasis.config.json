{
  "platform": {
    "name": "OASIS",
    "fullName": "Outil d'Administration et de Supervision Intégrée de la Sécurité",
    "version": "0.1.0",
    "phase": "Phase 1 — Socle technique transverse",
    "organisation": "UEMOA / URSAC"
  },
  "instance": {
    "etat": "Bénin",
    "codeEtat": "BJ",
    "type": "AAC",
    "etatsMembres": [
      "Bénin",
      "Burkina Faso",
      "Côte d'Ivoire",
      "Guinée-Bissau",
      "Mali",
      "Niger",
      "Sénégal",
      "Togo"
    ],
    "defaultLang": "fr",
    "langs": [
      "fr",
      "en",
      "pt"
    ]
  },
  "security": {
    "passwordMinLength": 12,
    "passwordRequireUpper": true,
    "passwordRequireLower": true,
    "passwordRequireDigit": true,
    "passwordRequireSpecial": true,
    "passwordMaxAgeDays": 180,
    "passwordHistoryCount": 5,
    "maxFailedAttempts": 5,
    "sessionTimeoutMinutes": 30,
    "singleSession": true,
    "forceChangeOnFirstLogin": true,
    "mfaEnabled": false
  },
  "database": {
    "driver": "json-file",
    "note": "Socle de démonstration : stockage fichier. Production : PostgreSQL 16 (cf. Note technique §4) — une base par État, réplication logique vers le serveur central UEMOA.",
    "postgres": {
      "host": "localhost",
      "port": 5432,
      "database": "oasis",
      "schema": "aac_bj",
      "ssl": true
    }
  },
  "replication": {
    "enabled": false,
    "mode": "async",
    "centralUrl": "https://central.ursac.uemoa.int/api/replication",
    "intervalMinutes": 15
  },
  "smtp": {
    "enabled": true,
    "host": "localhost",
    "port": 1025,
    "secure": false,
    "user": "",
    "pass": "",
    "from": "OASIS <no-reply@anac.bj>"
  },
  "interop": {
    "olf": {
      "enabled": false,
      "url": "https://olf.icao.int/api"
    },
    "istars": {
      "enabled": false,
      "url": "https://istars.icao.int/api"
    }
  },
  "modules": {
    "PLAN": true,
    "SURV": true,
    "CARE": true,
    "SAFA": true,
    "REG": false,
    "DOC": false,
    "CERT": false,
    "RISK": false,
    "FORM": false,
    "COM": false,
    "PAY": false
  },
  "aac": {
    "nom": "Agence Nationale de l'Aviation Civile",
    "sigle": "ANAC",
    "etat": "Bénin",
    "bigramme": "BJ",
    "pays": "Bénin",
    "ville": "Cotonou",
    "adresse1": "",
    "adresse2": "",
    "emailAdmin": "info@acsac.int",
    "logo": "data:image/png;base64,"
  },
  "singleSession": true
}
