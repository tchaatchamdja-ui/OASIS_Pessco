<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_P1" targetNamespace="urn:oasis:socle:bpmn" exporter="OASIS docs/bpmn (généré)" exporterVersion="1">
  <bpmn:collaboration id="Collab_P1">
    <bpmn:documentation>Ouverture d'une session : mot de passe, puis code à usage unique si la MFA est active. Routes server.js:227-284 ; règles src/auth.js:227-273 et src/mfa.js.</bpmn:documentation>
    <bpmn:participant id="Part_P1_Agent" name="Agent de l'AAC" processRef="Proc_P1_Agent"></bpmn:participant>
    <bpmn:participant id="Part_P1_Messagerie" name="Messagerie (SMTP)"><bpmn:documentation>src/email.js — le SMS passe par le même registre (src/mfa.js:87-88)</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Part_P1_Oasis" name="OASIS" processRef="Proc_P1_Oasis"></bpmn:participant>
    <bpmn:messageFlow id="Msg_P1_1" name="identifiant, mot de passe" sourceRef="a_saisir" targetRef="p_soumis" />
    <bpmn:messageFlow id="Msg_P1_2" name="code" sourceRef="sv_envoi" targetRef="Part_P1_Messagerie" />
    <bpmn:messageFlow id="Msg_P1_3" name="courriel du code" sourceRef="Part_P1_Messagerie" targetRef="a_code" />
    <bpmn:messageFlow id="Msg_P1_4" name="code, renvoi ou annulation" sourceRef="a_code" targetRef="p_etape" />
    <bpmn:messageFlow id="Msg_P1_5" name="page d'accueil" sourceRef="p_aller" targetRef="Part_P1_Agent" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P1_Agent" name="Agent — se connecter" isExecutable="false">
    <bpmn:startEvent id="a_debut" name="Besoin d'accéder à OASIS">
      <bpmn:outgoing>Flow_P1_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_saisir" name="Saisir identifiant et mot de passe">
      <bpmn:documentation>frontend/portail/pages/login-page.ts:97-120</bpmn:documentation>
      <bpmn:incoming>Flow_P1_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="a_gw" name="Un code est-il demandé ?">
      <bpmn:incoming>Flow_P1_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_code" name="Lire le code reçu et le saisir">
      <bpmn:documentation>login-page.ts:183-197</bpmn:documentation>
      <bpmn:incoming>Flow_P1_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="a_fin" name="Accueil ouvert ou refus affiché">
      <bpmn:incoming>Flow_P1_4</bpmn:incoming>
      <bpmn:incoming>Flow_P1_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1_1" sourceRef="a_debut" targetRef="a_saisir" />
    <bpmn:sequenceFlow id="Flow_P1_2" sourceRef="a_saisir" targetRef="a_gw" />
    <bpmn:sequenceFlow id="Flow_P1_3" name="oui" sourceRef="a_gw" targetRef="a_code" />
    <bpmn:sequenceFlow id="Flow_P1_4" name="non" sourceRef="a_gw" targetRef="a_fin" />
    <bpmn:sequenceFlow id="Flow_P1_5" sourceRef="a_code" targetRef="a_fin" />
  </bpmn:process>
  <bpmn:process id="Proc_P1_Oasis" name="P1_Connexion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P1_Oasis">
      <bpmn:lane id="Lane_P1_Portail" name="Portail — page de connexion">
        <bpmn:flowNodeRef>p_soumis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_etape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_gw_geste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_fin_annule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_post_mfa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_restants</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_aller</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_Serveur" name="Serveur">
        <bpmn:flowNodeRef>sv_debit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_429</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_fournis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_400</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_compte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_inconnu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_bloque</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_locked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_mdp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_mfa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_inst1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_inst1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_inst2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_inst2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_envoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_renvoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_expire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_essais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_gw_actif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fin_inactif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_session2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_fus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sv_cookie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_Magasin" name="Magasin">
        <bpmn:flowNodeRef>m_annuaire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_echec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_fin_echec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_raz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_defi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_verif</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p_soumis" name="Formulaire soumis">
      <bpmn:documentation>login-page.ts:97</bpmn:documentation>
      <bpmn:outgoing>Flow_P1_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p_soumis_def" />
    </bpmn:startEvent>
    <bpmn:task id="p_post" name="Bloquer le bouton ; POST /api/login">
      <bpmn:documentation>login-page.ts:99-120</bpmn:documentation>
      <bpmn:incoming>Flow_P1_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="p_etape" name="Afficher l'étape du code ; attendre le geste">
      <bpmn:documentation>login-page.ts:131, 147-166</bpmn:documentation>
      <bpmn:incoming>Flow_P1_31</bpmn:incoming>
      <bpmn:incoming>Flow_P1_43</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_32</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="p_gw_geste" name="Geste de l'agent ?">
      <bpmn:incoming>Flow_P1_32</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_33</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p_fin_annule" name="Retour au formulaire">
      <bpmn:documentation>mfaCancel : login-page.ts:168-181</bpmn:documentation>
      <bpmn:incoming>Flow_P1_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="p_resend" name="POST /api/login/mfa/resend (challengeId, username)">
      <bpmn:documentation>login-page.ts:199 et suivantes</bpmn:documentation>
      <bpmn:incoming>Flow_P1_34</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_post_mfa" name="POST /api/login/mfa (challengeId, code)">
      <bpmn:documentation>login-page.ts:183-191</bpmn:documentation>
      <bpmn:incoming>Flow_P1_35</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_restants" name="Afficher les essais restants">
      <bpmn:documentation>login-page.ts:193-196</bpmn:documentation>
      <bpmn:incoming>Flow_P1_42</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_aller" name="Aller à / (portail)">
      <bpmn:documentation>login-page.ts:132, 191. Écart : la page quittée n'est pas retenue.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_49</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_50</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="p_fin" name="Session ouverte">
      <bpmn:incoming>Flow_P1_50</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sv_debit" name="Plus de 20 essais en 15 min depuis cette IP ?">
      <bpmn:documentation>limiterAuth : src/protections.js:66-89</bpmn:documentation>
      <bpmn:incoming>Flow_P1_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_429" name="429 too_many_attempts (AUTH_DEBIT_DEPASSE)">
      <bpmn:documentation>src/protections.js:82-86</bpmn:documentation>
      <bpmn:incoming>Flow_P1_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="m_annuaire" name="Relire l'annuaire">
      <bpmn:documentation>server.js:231</bpmn:documentation>
      <bpmn:incoming>Flow_P1_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="sv_gw_fournis" name="Identifiant et mot de passe fournis ?">
      <bpmn:documentation>server.js:234</bpmn:documentation>
      <bpmn:incoming>Flow_P1_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_400" name="400 invalid">
      <bpmn:documentation>server.js:234</bpmn:documentation>
      <bpmn:incoming>Flow_P1_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sv_gw_compte" name="Compte connu et actif ?">
      <bpmn:documentation>src/auth.js:230-233 (LOGIN_ECHEC journalisé, S1)</bpmn:documentation>
      <bpmn:incoming>Flow_P1_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_inconnu" name="401 invalid">
      <bpmn:documentation>src/auth.js:232</bpmn:documentation>
      <bpmn:incoming>Flow_P1_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sv_gw_bloque" name="Compte bloqué ?">
      <bpmn:documentation>src/auth.js:234-237. Écart mineur : « locked » distinct de « invalid » révèle un compte existant.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_locked" name="401 locked">
      <bpmn:documentation>src/auth.js:236</bpmn:documentation>
      <bpmn:incoming>Flow_P1_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sv_gw_temp" name="Mot de passe temporaire expiré (48 h) ?">
      <bpmn:documentation>src/auth.js:239-242 ; durée server.js:40</bpmn:documentation>
      <bpmn:incoming>Flow_P1_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_temp" name="401 temp_expired">
      <bpmn:documentation>src/auth.js:241</bpmn:documentation>
      <bpmn:incoming>Flow_P1_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sv_gw_mdp" name="Mot de passe juste (scrypt) ?">
      <bpmn:documentation>src/auth.js:48-51, 243</bpmn:documentation>
      <bpmn:incoming>Flow_P1_18</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="m_echec" name="Incrémenter failedAttempts ; bloquer au seuil (5)">
      <bpmn:documentation>Décompte arrêté dans la transformation atomique ; COMPTE_BLOQUE ou LOGIN_ECHEC (S1), avis : src/auth.js:244-262</bpmn:documentation>
      <bpmn:incoming>Flow_P1_19</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="m_fin_echec" name="401 invalid ou locked">
      <bpmn:documentation>src/auth.js:263</bpmn:documentation>
      <bpmn:incoming>Flow_P1_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="m_raz" name="Remettre failedAttempts à 0">
      <bpmn:documentation>src/auth.js:265-267</bpmn:documentation>
      <bpmn:incoming>Flow_P1_21</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="sv_gw_mfa" name="MFA active ?">
      <bpmn:documentation>OASIS_MFA l'emporte sur security.mfaEnabled : server.js:220-225, 235 ; src/auth.js:269</bpmn:documentation>
      <bpmn:incoming>Flow_P1_22</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="sv_session" name="Créer la session ; journaliser LOGIN (S1)">
      <bpmn:documentation>Session unique : les autres sessions du compte sont retirées. src/auth.js:192-200, 270-271</bpmn:documentation>
      <bpmn:incoming>Flow_P1_23</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="sv_gw_inst1" name="Instance du compte désactivée ?">
      <bpmn:documentation>server.js:241</bpmn:documentation>
      <bpmn:incoming>Flow_P1_24</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_inst1" name="403 instance_desactivee — session et LOGIN déjà posés (écart)">
      <bpmn:documentation>server.js:242 ; la session créée par src/auth.js:270 reste dans la table, sans cookie.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sv_gw_inst2" name="Instance du compte désactivée ?">
      <bpmn:documentation>server.js:241</bpmn:documentation>
      <bpmn:incoming>Flow_P1_27</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_inst2" name="403 instance_desactivee">
      <bpmn:documentation>server.js:242</bpmn:documentation>
      <bpmn:incoming>Flow_P1_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="m_defi" name="Poser le défi : code à 6 chiffres, empreinte salée, 10 min">
      <bpmn:documentation>src/mfa.js:65-85</bpmn:documentation>
      <bpmn:incoming>Flow_P1_29</bpmn:incoming>
      <bpmn:incoming>Flow_P1_37</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="sv_envoi" name="Envoyer le code (sans attendre) ; journaliser MFA_CODE_ENVOYE">
      <bpmn:documentation>Un échec d'envoi ne part qu'aux traces : src/mfa.js:93-103</bpmn:documentation>
      <bpmn:incoming>Flow_P1_30</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="sv_renvoi" name="Retirer l'ancien défi ; en poser un pour le compte du corps (écart)">
      <bpmn:documentation>server.js:273-277 ; src/mfa.js:145-155. Écart mesuré : le défi n'est pas lié au compte, un défi valide permet d'en obtenir un pour un autre compte.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_36</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="m_verif" name="Vérifier le code dans la transformation atomique">
      <bpmn:documentation>src/mfa.js:112-139</bpmn:documentation>
      <bpmn:incoming>Flow_P1_38</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="sv_gw_verdict" name="Verdict ?">
      <bpmn:documentation>src/mfa.js:119-135</bpmn:documentation>
      <bpmn:incoming>Flow_P1_39</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_40</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_41</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_42</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_expire" name="401 mfa_expired">
      <bpmn:documentation>src/mfa.js:119 ; server.js:263</bpmn:documentation>
      <bpmn:incoming>Flow_P1_40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="sv_fin_essais" name="401 mfa_too_many_attempts">
      <bpmn:documentation>src/mfa.js:121-126</bpmn:documentation>
      <bpmn:incoming>Flow_P1_41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="sv_gw_actif" name="Compte actif ?">
      <bpmn:documentation>server.js:264-265. Écart : ni l'instance désactivée ni le blocage ne sont revérifiés ici.</bpmn:documentation>
      <bpmn:incoming>Flow_P1_44</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_45</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="sv_fin_inactif" name="401 invalid">
      <bpmn:documentation>server.js:265</bpmn:documentation>
      <bpmn:incoming>Flow_P1_45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="sv_session2" name="Créer la session ; journaliser LOGIN mfa (S1)">
      <bpmn:documentation>server.js:266-267</bpmn:documentation>
      <bpmn:incoming>Flow_P1_46</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="sv_fus" name="">
      <bpmn:incoming>Flow_P1_26</bpmn:incoming>
      <bpmn:incoming>Flow_P1_47</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_48</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="sv_cookie" name="Poser le cookie HttpOnly, SameSite=Lax (Secure en production)">
      <bpmn:documentation>server.js:208-212, 254, 268</bpmn:documentation>
      <bpmn:incoming>Flow_P1_48</bpmn:incoming>
      <bpmn:outgoing>Flow_P1_49</bpmn:outgoing>
